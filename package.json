
{
  "name": "athena5",
  "productName": "Athena Proctoring Tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app/app.js",
  "scripts": {
    "dev": "vite",
    "backend": "node backend/server.js",
    "backend:install": "npm --prefix backend install",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron ./app/app.js",
    "dist": "npm run build && electron-builder",
    "build.electron": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.priyesh.athena",
    "productName": "Athena Proctoring Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "package.json",
      "!node_modules/.cache/**/*"
    ],
    
"extraResources": [
  {
    "from": "backend",
    "to": "backend",
    "filter": [
      "server.js",
      "package.json",
      "package-lock.json",
      "data/**/*"
    ]
  },
  {
    "from": "backend/node_modules",
    "to": "backend/node_modules"
  }
],

    "mac": {
      "target": ["dmg"],
      "identity": null
    }
  }
}
